# Copy to .env and adjust. Used by `scenario_pipeliner run` / `examples/main.py`.

# --- library discovery ---
SCENARIO_PIPELINER_MODE=dev
SCENARIO_PIPELINER_PLUGINS_ROOT=examples/plugins
SCENARIO_PIPELINER_CORE_VERSION=0.1.0

# --- logging / observability ---
LEVEL_LOGGING=INFO
# SENTRY_DSN=
# ENV=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# --- runner entrypoint ---
RUNNER_DB_BACKEND=postgresql
RUNNER_POLL_INTERVAL_SECONDS=2
RUNNER_TASKS_LIMIT=10
# RUNNER_RUN_SECONDS=30
# RUNNER_APPLY_MIGRATIONS=true

# --- PostgreSQL (required for run / migrate-plugins) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scenario_pipeliner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
