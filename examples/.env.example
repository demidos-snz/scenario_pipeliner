# Copy to .env and adjust. CLI / RunnerApp load this file from cwd (and parents).
# Already-exported shell variables override values below.

# --- library discovery ---
SCENARIO_PIPELINER_MODE=dev
SCENARIO_PIPELINER_PLUGINS_ROOT=examples/plugins
# Must satisfy each plugin's core_compat (e.g. ">=0.0.1,<1.0")
SCENARIO_PIPELINER_CORE_VERSION=0.0.1
# Library objects: sp.tasks, sp.settings, … (not public, not sp_tasks)
SCENARIO_PIPELINER_DB_SCHEMA=sp

# --- logging / observability ---
LEVEL_LOGGING=INFO
# SENTRY_DSN=
# ENV=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1


# --- runner entrypoint ---
RUNNER_DB_BACKEND=postgresql
RUNNER_POLL_INTERVAL_SECONDS=2
RUNNER_TASKS_LIMIT=10
# RUNNER_ZOMBIE_TASKS_TIMEOUT_MINUTES=30
# RUNNER_MAX_CONCURRENT_TASKS=5
# RUNNER_HEARTBEAT_INTERVAL_SECONDS=30
# RUNNER_RECONCILE_LIMIT=50
# RUNNER_OUTBOX_LIMIT=20
# Drain after SIGTERM / stop(); not a per-batch SLA (default 30)
# RUNNER_SHUTDOWN_TIMEOUT_SECONDS=30
# RUNNER_RUN_SECONDS=30
# RUNNER_APPLY_MIGRATIONS=true

# --- PostgreSQL (required for run / migrate-plugins) ---
# Optional full URL (postgresql://, postgresql+asyncpg://, or postgresql+psycopg://).
# If unset or not a valid Postgres URL, POSTGRES_* below are used.
# POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scenario_pipeliner
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scenario_pipeliner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
